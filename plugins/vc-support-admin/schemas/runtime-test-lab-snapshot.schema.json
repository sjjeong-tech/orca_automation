{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved TEST LAB runtime snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "sanitized", "environment", "data_source_id", "transaction_id", "snapshot_hash", "record_counts", "records", "relations", "fund_work", "request", "tasks", "human_confirmation"],
  "properties": {
    "version": {"const": "1.0"},
    "source": {"enum": ["APPROVED_SESSION", "SESSION_TOOL_BRIDGE"]},
    "sanitized": {"const": true},
    "environment": {"const": "TEST_LAB"},
    "data_source_id": {"type": "string", "pattern": "^collection://[0-9a-f-]{36}$"},
    "transaction_id": {"type": "string", "pattern": "^[A-Z0-9-]{3,64}$"},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_counts": {"type": "object", "additionalProperties": false, "required": ["fund_work", "request", "task"], "properties": {"fund_work": {"const": 1}, "request": {"const": 1}, "task": {"const": 6}}},
    "records": {"type": "object", "additionalProperties": false, "required": ["fund_work", "request", "tasks"], "properties": {"fund_work": {"type": "object"}, "request": {"type": "object"}, "tasks": {"type": "array", "minItems": 6, "maxItems": 6}}},
    "relations": {"type": "object", "additionalProperties": false, "required": ["fund_work_to_request", "request_to_tasks"], "properties": {"fund_work_to_request": {"const": "EXACT_1"}, "request_to_tasks": {"const": "EXACT_1"}}},
    "fund_work": {"type": "object", "additionalProperties": false, "required": ["count", "master_match"], "properties": {"count": {"const": 1}, "master_match": {"const": "EXACT_1"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["count", "fund_relation", "completion_allowed"], "properties": {"count": {"const": 1}, "fund_relation": {"const": "EXACT_1"}, "completion_allowed": {"const": false}}},
    "tasks": {"type": "array", "minItems": 6, "maxItems": 6},
    "human_confirmation": {"type": "array", "minItems": 3, "maxItems": 3}
  }
}
