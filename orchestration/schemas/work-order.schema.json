{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Order",
  "type": "object",
  "required": ["work_order_id", "work_item_id", "issued_by", "assigned_to", "base_commit", "objective", "input_gate", "required_inputs", "allowed_actions", "forbidden_actions", "allowed_paths", "outputs", "validation", "continuation_policy", "stop_conditions", "runtime_limit", "checkpoint_interval", "commit_policy", "push_policy", "handoff_required"],
  "properties": {
    "work_order_id": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "runtime_limit": {"type": "integer", "maximum": 90},
    "checkpoint_interval": {"type": "integer", "maximum": 30},
    "outputs": {"type": "array", "minItems": 1},
    "validation": {"type": "array", "minItems": 1},
    "handoff_required": {"type": "boolean"}
  }
}
